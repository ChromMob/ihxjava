def main():
    parser = argparse.ArgumentParser(
        prog=NAME, description="Use JetBrains' official IntelliJ language server from Helix or Neovim."
    )
    parser.add_argument('--version', action='version', version=f'{NAME} {VERSION}')
    sub = parser.add_subparsers(dest='command', required=True)

    p = sub.add_parser('install', help='download the official server (also updates it)')
    p.add_argument('--force', action='store_true', help='reinstall even if up to date')
    p.add_argument('--keep-old', action='store_true', help='keep previously installed servers')
    p.add_argument('--extension-version', help='take the server pinned by this extension version')
    p.set_defaults(func=cmd_install)

    p = sub.add_parser('setup', help='accept the EULA and choose region and data sharing')
    p.add_argument('--accept-eula', action='store_true', help='accept the bundled JetBrains User Agreement')
    p.add_argument('--region', choices=REGIONS)
    p.add_argument('--data-sharing', choices=DATA_SHARING)
    p.add_argument('--reconfigure', action='store_true', help='ask again for region and data sharing')
    p.set_defaults(func=cmd_setup)

    p = sub.add_parser('license', help="run the server's license command (status, login, activate, trial, reset)")
    p.add_argument('rest', nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_license)

    p = sub.add_parser('lsp', help='run the language server over stdio (what the editor starts)')
    p.set_defaults(func=cmd_lsp)

    p = sub.add_parser('doctor', help='show the installation, settings and license state')
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser('logs', help="print the path of a project's server log")
    p.add_argument('project', nargs='?', help='project root (default: current directory)')
    p.set_defaults(func=cmd_logs)

    p = sub.add_parser('clean', help='delete indexes and decompiled classes (quit editors first)')
    p.set_defaults(func=cmd_clean)

    p = sub.add_parser('helix-config', help='print a languages.toml snippet')
    p.set_defaults(func=cmd_helix_config)

    p = sub.add_parser('uninstall', help='remove the downloaded server')
    p.add_argument('--all', action='store_true', help='also remove caches and settings')
    p.set_defaults(func=cmd_uninstall)

    args = parser.parse_args()
    try:
        sys.exit(args.func(args) or 0)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == '__main__':
    main()
