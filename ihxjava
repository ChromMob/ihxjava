#!/usr/bin/env python3
"""Run JetBrains' official IntelliJ language server (Java and Kotlin) in Helix or Neovim.

Nothing from JetBrains is bundled with this tool. `install` fetches the official
"Java and Kotlin by IntelliJ IDEA" VS Code extension from Open VSX, reads the server
bundle it pins (`server-bundle.json`), and downloads that bundle from
download.jetbrains.com, verifying both checksums. The official launcher is then run
unmodified. `lsp`, the command the editor starts, is a thin stdio bridge that does the
parts the VS Code client normally does: passing the accepted-EULA hash and consent
settings, choosing a per-workspace index directory, filling in initialization
options, and turning `jar:`/`jrt:` locations (library and JDK classes) into
decompiled files that the editor can open.
"""

import argparse
import hashlib
import io
import json
import os
import platform
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import threading
import urllib.parse
import urllib.request
import zipfile
from pathlib import Path

NAME = 'ihxjava'
VERSION = '0.1.0'

OPEN_VSX = 'https://open-vsx.org/api/JetBrains/intellij-server'
BUNDLE_HOST = 'download.jetbrains.com'
REGIONS = ['africa', 'americas', 'apac', 'china', 'europe', 'middle_east', 'oceania']
REGION_LABELS = {
    'africa': 'Africa',
    'americas': 'Americas',
    'apac': 'Asia (except Mainland China)',
    'china': 'Mainland China',
    'europe': 'Europe',
    'middle_east': 'Middle East',
    'oceania': 'Oceania',
}
DATA_SHARING = ['none', 'anonymous', 'full']
DATA_SHARING_LABELS = {
    'none': 'Do not send usage statistics or error reports',
    'anonymous': 'Anonymous usage statistics and anonymized error reports',
    'full': 'Anonymous usage statistics and full error reports',
}


def xdg_dir(var, fallback):
    base = os.environ.get(var)
    base = Path(base) if base and os.path.isabs(base) else Path.home() / fallback
    return base / NAME


DATA_DIR = xdg_dir('XDG_DATA_HOME', '.local/share')
CONFIG_DIR = xdg_dir('XDG_CONFIG_HOME', '.config')
CACHE_DIR = xdg_dir('XDG_CACHE_HOME', '.cache')
CONFIG_FILE = CONFIG_DIR / 'config.json'
INSTALL_FILE = DATA_DIR / 'installed.json'
SERVERS_DIR = DATA_DIR / 'server'
SYSTEM_DIR = CACHE_DIR / 'system'
DECOMPILED_DIR = CACHE_DIR / 'decompiled'
VERBOSE = os.environ.get('IHXJAVA_VERBOSE', '') not in ('', '0')

# What the launcher prints on every start; editors show each stderr line as an error.
LAUNCHER_NOISE = re.compile(rb'^(IJ_JAVA_OPTIONS=|idea\.(config|system)\.path=|Log file: )')

HELIX_SNIPPET = '''\
[language-server.intellij]
command = "ihxjava"
args = ["lsp"]
# Importing and indexing a project can take a while on first start.
timeout = 120

# Sent to the server as initializationOptions. All keys are optional.
[language-server.intellij.config]
# buildTool = "gradle"         # gradle | maven | bazel | jps; "" disables project import
# defaultSdk = "/usr/lib/jvm/java-21-openjdk"

[[language]]
name = "java"
language-servers = ["intellij"]

[[language]]
name = "kotlin"
language-servers = ["intellij"]
'''


def log(*parts):
    print(f'{NAME}:', *parts, file=sys.stderr, flush=True)


def die(message):
    log(message)
    sys.exit(1)


def load_json(path, default):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


def save_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + '.tmp')
    tmp.write_text(json.dumps(value, indent=2) + '\n')
    tmp.replace(path)


def load_config():
    config = load_json(CONFIG_FILE, {})
    return config if isinstance(config, dict) else {}


def load_install():
    install = load_json(INSTALL_FILE, None)
    if not isinstance(install, dict) or not Path(install.get('launcher', '')).is_file():
        return None
    return install


def eula_hash(eula_path):
    # Same recipe as the VS Code extension: the first 16 hex digits of the EULA's sha256.
    return hashlib.sha256(Path(eula_path).read_bytes()).hexdigest()[:16]


def readiness_problem(install, config):
    """Why the server can't start yet, or None. Phrased for someone reading the editor's log."""
    if install is None:
        return f'the IntelliJ language server is not installed; run `{NAME} install`'
    if config.get('eulaAccepted') != eula_hash(install['eula']):
        return f'the JetBrains User Agreement has not been accepted; run `{NAME} setup`'
    if config.get('region') not in REGIONS:
        return f'no region is selected; run `{NAME} setup`'
    if config.get('dataSharing', 'none') not in DATA_SHARING:
        return f'`dataSharing` in {CONFIG_FILE} must be one of {", ".join(DATA_SHARING)}'
    return None


def system_path(install, root):
    """The server's caches and indexes for one workspace."""
    digest = hashlib.sha256(str(root).encode()).hexdigest()[:16]
    return SYSTEM_DIR / install['serverVersion'] / digest


def shell_quote_if_needed(arg):
    if re.fullmatch(r'[a-zA-Z0-9._=:/@-]+', arg):
        return arg
    return '"' + re.sub(r'(["\\$`])', r'\\\1', arg) + '"'


def server_env(config, install):
    env = dict(os.environ)
    # The launcher's debug log goes to stdout, which is the protocol channel in --stdio mode.
    env.pop('IJ_LAUNCHER_DEBUG', None)
    env.pop('INTELLIJ_DATA_SHARING', None)
    env.pop('INTELLIJ_REGION', None)
    data_sharing = config.get('dataSharing', 'none')
    if data_sharing != 'none':
        env['INTELLIJ_DATA_SHARING'] = data_sharing
    if config.get('region') in REGIONS:
        env['INTELLIJ_REGION'] = config['region']
    jvm_args = config.get('jvmArgs') or []
    if jvm_args:
        extra = ' '.join(shell_quote_if_needed(str(a)) for a in jvm_args)
        current = env.get('IJ_JAVA_OPTIONS', '')
        env['IJ_JAVA_OPTIONS'] = f'{current} {extra}' if current else extra
    if install is not None and config.get('eulaAccepted') == eula_hash(install['eula']):
        env['INTELLIJ_SERVER_EULA'] = config['eulaAccepted']
    return env


