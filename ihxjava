# install / update / uninstall


def vsix_target():
    system = {'Linux': 'linux', 'Darwin': 'darwin'}.get(platform.system())
    arch = {'x86_64': 'x64', 'amd64': 'x64', 'aarch64': 'arm64', 'arm64': 'arm64'}.get(
        platform.machine().lower()
    )
    if system is None or arch is None:
        die(f'unsupported platform: {platform.system()} {platform.machine()}')
    return f'{system}-{arch}'


def http_get(url):
    request = urllib.request.Request(url, headers={'User-Agent': f'{NAME}/{VERSION}'})
    with urllib.request.urlopen(request, timeout=60) as response:
        return response.read()


def download(url, dest, expected_sha256):
    dest.parent.mkdir(parents=True, exist_ok=True)
    part = dest.with_name(dest.name + '.part')
    request = urllib.request.Request(url, headers={'User-Agent': f'{NAME}/{VERSION}'})
    digest = hashlib.sha256()
    with urllib.request.urlopen(request, timeout=60) as response, open(part, 'wb') as out:
        total = int(response.headers.get('Content-Length') or 0)
        done = 0
        while chunk := response.read(1 << 20):
            out.write(chunk)
            digest.update(chunk)
            done += len(chunk)
            if total and sys.stderr.isatty():
                print(f'\r  {done >> 20} / {total >> 20} MiB', end='', file=sys.stderr, flush=True)
    if total and sys.stderr.isatty():
        print(file=sys.stderr)
    if digest.hexdigest() != expected_sha256.lower():
        part.unlink(missing_ok=True)
        die(f'checksum mismatch for {url}')
    part.replace(dest)


def extract(archive, dest_parent):
    tmp = Path(tempfile.mkdtemp(dir=dest_parent, prefix='.extract-'))
    with tarfile.open(archive) as tar:
        try:
            tar.extractall(tmp, filter='data')
        except tarfile.FilterError:
            # The archive is checksum-verified; 'tar' still refuses paths outside the target.
            shutil.rmtree(tmp)
            tmp.mkdir()
            tar.extractall(tmp, filter='tar')
    launchers = sorted(tmp.glob('**/bin/intellij-server'), key=lambda p: len(p.parts))
    if not launchers:
        shutil.rmtree(tmp)
        die('the downloaded server bundle has no bin/intellij-server launcher')
    return tmp, launchers[0].parent.parent


def cmd_install(args):
    target = vsix_target()
    log(f'looking up the official extension for {target} on Open VSX')
    meta = json.loads(http_get(f'{OPEN_VSX}/{target}/{args.extension_version or "latest"}'))
    files = meta['files']
    vsix_sha = http_get(files['sha256']).decode().split()[0]
    log(f'downloading extension {meta["version"]}')
    vsix = http_get(files['download'])
    if hashlib.sha256(vsix).hexdigest() != vsix_sha.lower():
        die('extension checksum mismatch')
    with zipfile.ZipFile(io.BytesIO(vsix)) as z:
        bundle = json.loads(z.read('extension/server-bundle.json'))

    url = urllib.parse.urlsplit(bundle['url'])
    if url.scheme != 'https' or url.hostname != BUNDLE_HOST:
        die(f'refusing to download the server from an unexpected location: {bundle["url"]}')

    current = load_install()
    if current and current.get('serverVersion') == bundle['version'] and not args.force:
        log(f'server {bundle["version"]} is already installed (use --force to reinstall)')
        return

    SERVERS_DIR.mkdir(parents=True, exist_ok=True)
    archive = DATA_DIR / 'downloads' / bundle['archiveName']
    log(f'downloading IntelliJ server {bundle["version"]} from {BUNDLE_HOST}')
    download(bundle['url'], archive, bundle['sha256'])
    log('extracting')
    tmp, root = extract(archive, SERVERS_DIR)
    dest = SERVERS_DIR / bundle['version']
    if dest.exists():
        shutil.rmtree(dest)
    root.rename(dest)
    shutil.rmtree(tmp, ignore_errors=True)
    archive.unlink(missing_ok=True)

    launcher = dest / 'bin' / 'intellij-server'
    install = {
        'serverVersion': bundle['version'],
        'extensionVersion': meta['version'],
        'target': target,
        'serverDir': str(dest),
        'launcher': str(launcher),
        'eula': str(dest / 'EULA.txt'),
    }
    save_json(INSTALL_FILE, install)
    if not args.keep_old:
        for old in SERVERS_DIR.iterdir():
            if old != dest and old.is_dir() and not old.name.startswith('.'):
                shutil.rmtree(old, ignore_errors=True)
    log(f'installed server {bundle["version"]} in {dest}')

    problem = readiness_problem(install, load_config())
    if problem:
        log(f'next: {problem}')


def cmd_uninstall(args):
    for path in [DATA_DIR] + ([CACHE_DIR] if args.all else []):
        if path.exists():
            shutil.rmtree(path)
            log(f'removed {path}')
    if args.all and CONFIG_DIR.exists():
        shutil.rmtree(CONFIG_DIR)
        log(f'removed {CONFIG_DIR}')


